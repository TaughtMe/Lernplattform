# Supabase-Zugangsdaten fürs Laufdiktat-Modul (Live-Räume). Findest du im
# Supabase-Dashboard unter Project Settings -> API. Datei nach ".env" kopieren
# und Werte eintragen. Ohne diese Werte laden /raum und /lehrer trotzdem,
# zeigen aber nur einen Hinweis statt echter Räume (siehe
# src/laufdiktat/supabase-client.ts).
#
# Vor der ersten Nutzung müssen die SQL-Dateien unter supabase/migrations/
# in der angegebenen Reihenfolge auf das Supabase-Projekt angewendet werden
# (Supabase-Dashboard -> SQL Editor, oder supabase CLI).

NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=dein-publishable-key
