{
  "name": "lernraum",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/generate-service-worker.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/generate-service-worker.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "format": "prettier --write app src e2e tests docs *.json *.ts *.mjs",
    "format:check": "prettier --check app src e2e tests docs *.json *.ts *.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run build && npm run test:render",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=desktop-chromium --project=mobile-chrome --project=minimum-width",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:render",
    "quality": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.105.4",
    "dexie": "4.4.4",
    "qr-scanner": "1.4.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.51.3",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "globals": "16.4.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  },
  "type": "module"
}
