{
  "name": "lernraum",
  "version": "0.9.4",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/generate-service-worker.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/generate-service-worker.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "format": "prettier --write app src e2e tests docs *.json *.ts *.mjs",
    "format:check": "prettier --check app src e2e tests docs *.json *.ts *.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "node scripts/css-module-types.mjs --check && tsc --noEmit",
    "test": "npm run test:unit && npm run build && npm run test:render",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:database": "node --test tests/database-contract.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=desktop-chromium --project=mobile-chrome --project=minimum-width",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:database && npm run build && npm run test:render",
    "quality": "npm run check && npm run test:e2e && npm run test:e2e:live",
    "css-types": "node scripts/css-module-types.mjs",
    "design:references": "node scripts/render-design-references.mjs",
    "test:design": "playwright test --config playwright.design.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "dexie": "4.4.6",
    "katex": "^0.19.0",
    "qr-scanner": "1.4.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.65.0",
    "@electric-sql/pglite": "0.5.11",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "globals": "16.4.0",
    "jsdom": "29.1.1",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "wrangler": "4.152.0"
  },
  "type": "module"
}
